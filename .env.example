# Copie este archivo como .env y complete los valores.  .env NUNCA se sube a GitHub.

# --- Jenkins (usuario administrador que se crea automáticamente) ---
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=cambie-esta-clave

# URL del repositorio en GitHub que Jenkins va a construir
GIT_REPO_URL=https://github.com/USUARIO/REPO.git
GIT_BRANCH=main
# URL pública de Jenkins (la de ngrok si usan webhook), terminada en /
JENKINS_URL=http://localhost:8080/

# --- Kaggle (Perfil -> Settings -> API -> Create New Token, abre kaggle.json) ---
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Dataset (por defecto: Chicago Crime 2012-2017, ~1.45 M registros) ---
KAGGLE_DATASET=currie32/crimes-in-chicago
KAGGLE_FILE=Chicago_Crimes_2012_to_2017.csv
# 0 = cargar todo; un número > 0 toma una muestra aleatoria de ese tamaño
SAMPLE_ROWS=0

# --- Recursos (bájelos si el equipo tiene poca RAM) ---
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1g
DASK_WORKER_THREADS=2
DASK_WORKER_MEMORY=1.5GiB

# Tamaño de celda de la grilla en grados (0.005 ≈ 550 m x 410 m en Chicago)
GRID_SIZE=0.005
